<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
    <ProjectReference Include="../../src/AgentWatch/AgentWatch.csproj" />
    <ProjectReference Include="../AgentWatch.TestHelper/AgentWatch.TestHelper.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyTestHelper" AfterTargets="Build">
    <ItemGroup><HelperFile Include="../AgentWatch.TestHelper/bin/$(Configuration)/$(TargetFramework)/*" /></ItemGroup>
    <Copy SourceFiles="@(HelperFile)" DestinationFolder="$(OutDir)helper" SkipUnchangedFiles="true" />
  </Target>
</Project>
